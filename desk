def tr(text, *args):
    if LANG == "ru":
        text = RU.get(text, text)
    return text.format(*args) if args else text


# ── KDE ini ────────────────────────────────────────────────────────────────────
# KConfig is not quite ini: headers look like [A][B][C], keys like key[$e]. So a small
# parser of its own: lines are kept verbatim, groups and keys are compared by name.

def parse_ini(text):
    groups, name, lines = [], "", []
    for line in text.splitlines():
        if line.startswith("[") and line.rstrip().endswith("]"):
            groups.append((name, lines))
            name, lines = line.rstrip()[1:-1], []
        else:
            lines.append(line)
    groups.append((name, lines))
    return groups


def dump_ini(groups):
    out = []
    for name, lines in groups:
        body = list(lines)
        while body and body[-1].strip() == "":
            body.pop()
        if name == "" and not body:
            continue
        if name:
            out.append(f"[{name}]")
        out.extend(body)
        out.append("")
    return "\n".join(out).rstrip("\n") + "\n"


def key_of(line):
    if "=" not in line or line.lstrip().startswith("#"):
        return None
    return re.sub(r"\[\$.*?\]$", "", line.split("=", 1)[0].strip())


def matches(rule, group):
    kind, arg = rule[0], rule[1]
    return (kind == "group" and group == arg) or (kind == "prefix" and group.startswith(arg))


def extract(text, rules):
    """The part of a file a theme takes."""
    picked = []
    for name, lines in parse_ini(text):
        if any(matches(r, name) for r in rules if r[0] != "keys"):
            picked.append((name, lines))
        for r in rules:
            if r[0] == "keys" and name == r[1]:
                kept = [l for l in lines if key_of(l) in r[2]]
                if kept:
                    picked.append((name, kept))
    return dump_ini(picked) if picked else ""


def merge(current, saved, rules):
    """The live file with the theme's part replaced by the saved one."""
    groups = parse_ini(current)
    out = []
    for name, lines in groups:
        if any(matches(r, name) for r in rules if r[0] != "keys"):
            continue
        for r in rules:
            if r[0] == "keys" and name == r[1]:
                lines = [l for l in lines if key_of(l) not in r[2]]
        out.append((name, lines))
    for name, lines in parse_ini(saved):
        if not name:
            continue
        for i, (n, l) in enumerate(out):
            if n == name:
                out[i] = (n, [x for x in l if x.strip()] + lines)
                break
        else:
            out.append((name, lines))
    return dump_ini(out)


