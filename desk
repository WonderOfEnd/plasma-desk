# ── Themes ─────────────────────────────────────────────────────────────────────

def theme_dir(name):
    if not name or name.startswith(".") or "/" in name:
        die(tr("Invalid theme name: “{}”", name))
    return ROOT / name


def themes():
    if not ROOT.exists():
        return []
    return sorted(p.name for p in ROOT.iterdir() if p.is_dir() and not p.name.startswith("."))


def current():
    try:
        return CURRENT.read_text().strip()
    except OSError:
        return ""


def snapshot(dest, with_assets=True):
    """Take the current state into dest/config."""
    tmp = dest.with_name(dest.name + ".tmp")
    shutil.rmtree(tmp, ignore_errors=True)
    (tmp / "config").mkdir(parents=True)
    absent = []
    for rel in WHOLE:
        src = CONFIG / rel
        dst = tmp / "config" / rel
        if src.is_file():
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
        else:
            absent.append(rel)
    (tmp / "config" / ABSENT).write_text("".join(r + "\n" for r in absent))
    for rel in WHOLE_DIRS:
        if (CONFIG / rel).is_dir():
            shutil.copytree(CONFIG / rel, tmp / "config" / rel)
    absent_data = []
    for rel in DATA_DIRS:
        if (SHARE / rel).is_dir():
            shutil.copytree(SHARE / rel, tmp / "share" / rel, symlinks=True)
        else:
            absent_data.append(rel)
    (tmp / "config" / ABSENT_DATA).write_text("".join(r + "\n" for r in absent_data))
    for rel, rules in PARTIAL.items():
        src = CONFIG / rel
        part = extract(src.read_text(errors="replace"), rules) if src.is_file() else ""
        (tmp / "config" / (rel + ".part")).write_text(part)
    # An Aurorae decoration keeps its settings in ~/.config/<theme>rc.
    kwin = CONFIG / "kwinrc"
    if kwin.is_file():
        m = re.search(r"^theme=__aurorae__svg__(.+)$", kwin.read_text(errors="replace"), re.M)
        if m and (CONFIG / f"{m.group(1)}rc").is_file():
            shutil.copy2(CONFIG / f"{m.group(1)}rc", tmp / "config" / f"{m.group(1)}rc")
    collect_assets(tmp, copy=with_assets)
    # The icon and preview are not part of the snapshot: carry them over from the old version.
    for extra in KEEP_FILES:
        if (dest / extra).is_file():
            shutil.copy2(dest / extra, tmp / extra)
    shutil.rmtree(dest, ignore_errors=True)
    tmp.rename(dest)


def collect_assets(tmp, copy=True):
    """Copy the wallpapers the snapshot references into .assets/ and point the references there.

    A copy is named by a hash of its contents, so with copy=False references are rewritten
    the same way without copying: a snapshot taken for comparison then matches the saved
    theme even while the live config still points at the original files.
    """
    if copy:
        ASSETS.mkdir(parents=True, exist_ok=True)
    for f in (tmp / "config").rglob("*"):
        if not f.is_file():
            continue
        try:
            text = f.read_text()
        except UnicodeDecodeError:
            continue

        def repl(m):
            raw = m.group(1)
            path = Path(unquote(raw))
            if not path.is_file() or path.parent == ASSETS:
                return m.group(0)
            h = hashlib.sha1(path.read_bytes()).hexdigest()[:12]
            stored = ASSETS / f"{h}-{path.name}"
            if copy and not stored.exists():
                shutil.copy2(path, stored)
            new = str(stored)
            if raw != unquote(raw):                   # the reference was %-encoded
                new = quote(new)
            return m.group(0).replace(raw, new)

        new_text = PATH_RE.sub(repl, text)
        if new_text != text:
            f.write_text(new_text)


def gc_assets():
    """Drop wallpapers from .assets/ that no theme, backup or ~/.config references."""
    if not ASSETS.exists():
        return
    refs = ""
    dirs = [p for p in ROOT.iterdir() if p.is_dir()]
    if BACKUPS.exists():
        dirs += [p for p in BACKUPS.iterdir() if p.is_dir()]
    for base in [p / "config" for p in dirs]:
        for f in base.rglob("*"):
            if f.is_file():
                refs += f.read_text(errors="replace")
    for rel in WHOLE + list(PARTIAL):
        f = CONFIG / rel
        if f.is_file():
            refs += f.read_text(errors="replace")
    refs = refs + unquote(refs)
    for a in ASSETS.iterdir():
        if a.name not in refs:
            a.unlink()


def write_back(src_dir):
    """Write the snapshot src_dir into ~/.config. Plasma must be stopped at this point."""
    cfg = src_dir / "config"
    for rel in WHOLE:
        src, dst = cfg / rel, CONFIG / rel
        if src.is_file():
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
    if (cfg / ABSENT).is_file():
        for rel in (cfg / ABSENT).read_text().split():
            if rel in WHOLE and (CONFIG / rel).is_file():
                (CONFIG / rel).unlink()
    for rel in WHOLE_DIRS:
        if (cfg / rel).is_dir():
            shutil.rmtree(CONFIG / rel, ignore_errors=True)
            shutil.copytree(cfg / rel, CONFIG / rel)
    gone = (cfg / ABSENT_DATA).read_text().split() if (cfg / ABSENT_DATA).is_file() else []
    for rel in DATA_DIRS:
        src = src_dir / "share" / rel
        if src.is_dir() or rel in gone:
            shutil.rmtree(SHARE / rel, ignore_errors=True)
        if src.is_dir():
            shutil.copytree(src, SHARE / rel, symlinks=True)
    for rel, rules in PARTIAL.items():
        part = cfg / (rel + ".part")
        if not part.is_file():
            continue
        dst = CONFIG / rel
        cur = dst.read_text(errors="replace") if dst.is_file() else ""
        dst.write_text(merge(cur, part.read_text(), rules))
    for f in cfg.glob("*rc"):
        if f.name not in WHOLE:
            shutil.copy2(f, CONFIG / f.name)


def data_dirs():
    dirs = [SHARE] + [Path(d) for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]
    return list(dict.fromkeys(dirs))


def plugin_dirs():
    """Qt 6 plugin directories: they differ between distributions."""
    dirs = [Path(d) for d in os.environ.get("QT_PLUGIN_PATH", "").split(":") if d]
    dirs += [Path(d) for d in glob.glob("/usr/lib*/qt6/plugins") + glob.glob("/usr/lib/*/qt6/plugins")]
    return list(dict.fromkeys(dirs))


def missing_deps(src_dir):
    """Widgets, wallpaper plugins and looks the theme references but that are not installed."""
    cfg = src_dir / "config"
    text = ""
    for f in cfg.rglob("*"):
        if f.is_file():
            text += f.read_text(errors="replace") + "\n"
    share, plugins = data_dirs(), plugin_dirs()
    out = []

    def have(*rels):
        return any((b / r).exists() for b in share for r in rels)

    def have_plugin(rel):
        return any((b / rel).exists() for b in plugins)

    for pid in sorted(set(re.findall(r"^plugin=(\S+)$", text, re.M))):
        if not (have(f"plasma/plasmoids/{pid}") or have_plugin(f"plasma/applets/{pid}.so")):
            out.append(tr("widget {}", pid))
    for wid in sorted(set(re.findall(r"^wallpaperplugin=(\S+)$", text, re.M))):
        if not (have(f"plasma/wallpapers/{wid}") or have_plugin(f"plasma/wallpapers/{wid}.so")):
            out.append(tr("wallpaper plugin {}", wid))
    for k, rel in [("LookAndFeelPackage", "plasma/look-and-feel/{}"), ("cursorTheme", "icons/{}"),
                   ("ColorScheme", "color-schemes/{}.colors")]:
        for v in set(re.findall(rf"^{k}=(.+)$", text, re.M)):
            if k == "cursorTheme" and (HOME / ".icons" / v).exists():   # cursors may live in ~/.icons
                continue
            if not have(rel.format(v)):
                out.append(f"{k}={v}")
    for v in set(re.findall(r"^\[Icons\]\nTheme=(.+)$", text, re.M)):
        if not (have(f"icons/{v}") or (HOME / ".icons" / v).exists()):
            out.append(tr("icons {}", v))
    return out


# ── Plasma ─────────────────────────────────────────────────────────────────────

def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", f"{cmd[0]}: not found")


def shell_under_systemd():
    return run("systemctl", "--user", "--quiet", "is-active", "plasma-plasmashell.service").returncode == 0


def stop_shell():
    if shell_under_systemd():
        run("systemctl", "--user", "stop", "plasma-plasmashell.service")
    else:
        run("kquitapp6", "plasmashell")
    for _ in range(50):
        if run("pgrep", "-x", "plasmashell").returncode != 0:
            return
        time.sleep(0.1)


def start_shell():
    # A few switches in a row trip systemd's start rate limit ("start-limit-hit") and the
    # shell stays down; clearing the failed state lifts the limit for this start.
    run("systemctl", "--user", "reset-failed", "plasma-plasmashell.service")
    if run("systemctl", "--user", "start", "plasma-plasmashell.service").returncode != 0:
        subprocess.Popen(["kstart", "plasmashell"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def read_key(rel, group, key):
    r = run("kreadconfig6", "--file", str(CONFIG / rel), "--group", group, "--key", key)
    return r.stdout.strip()


def changeicons():
    """plasma-changeicons sits in libexec, which differs between distributions."""
    for pattern in ("/usr/libexec/plasma-changeicons", "/usr/lib*/libexec/plasma-changeicons",
                    "/usr/lib/*/libexec/plasma-changeicons", "/usr/lib/*/plasma-changeicons"):
        for p in glob.glob(pattern):
            return p
    return None


def notify_apps():
    """Tell running applications and KWin that the look has changed."""
    scheme = read_key("kdeglobals", "General", "ColorScheme")
    if scheme:
        run("plasma-apply-colorscheme", scheme)
    cursor = read_key("kcminputrc", "Mouse", "cursorTheme") or "breeze_cursors"
    run("plasma-apply-cursortheme", cursor)
    icons = read_key("kdeglobals", "Icons", "Theme") or "breeze"
    tool = changeicons()
    if tool:
        run(tool, icons)
    for change in (0, 1, 2, 3, 4, 5):   # palette, fonts, style, settings, icons, cursor
        run("busctl", "--user", "emit", "/KGlobalSettings", "org.kde.KGlobalSettings",
            "notifyChange", "ii", str(change), "0")
    # The same signal KConfig sends when writing with the Notify flag: on it running apps and
    # kde-gtk-config (which carries font, icons and cursor over to GTK) reload the look.
    # desk writes files directly, so it sends the signal itself.
    for path, groups in [("/kdeglobals", "{'General': [b'font', b'fixed', b'menuFont', "
                          "b'smallestReadableFont', b'toolBarFont', b'ColorScheme'], "
                          "'Icons': [b'Theme'], 'KDE': [b'widgetStyle', b'LookAndFeelPackage'], "
                          "'WM': [b'activeFont']}"),
                         ("/kcminputrc", "{'Mouse': [b'cursorTheme', b'cursorSize']}"),
                         # KWin re-reads layout labels only on this signal,
                         # org.kde.keyboard.reloadConfig does not update them.
                         ("/kxkbrc", "{'Layout': [b'DisplayNames']}")]:
        run("gdbus", "emit", "--session", "--object-path", path,
            "--signal", "org.kde.kconfig.notify.ConfigChanged", groups)
    run("dbus-send", "--session", "--type=signal", "/Layouts", "org.kde.keyboard.reloadConfig")
    run("busctl", "--user", "call", "org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure")


def install(src_dir):
    # plasmashell rewrites its config files on exit, so they are written while it is stopped.
    stop_shell()
    try:
        write_back(src_dir)
    finally:
        start_shell()
    notify_apps()


def backup():
    BACKUPS.mkdir(parents=True, exist_ok=True)
    dest = BACKUPS / time.strftime("%Y-%m-%d_%H-%M-%S")
    snapshot(dest)
    (dest / "from").write_text(current())
    for old in sorted(p for p in BACKUPS.iterdir() if p.is_dir())[:-KEEP_BACKUPS]:
        shutil.rmtree(old, ignore_errors=True)
    gc_assets()
    return dest


# Keys widgets rewrite by themselves while working (launch counters in menus, update check
# times, popup sizes): changing them is not an edit of the desktop.
VOLATILE = ("appLaunchCounts", "lastUpdateCheckTime", "LastVideoPosition",
            "popupWidth", "popupHeight", "DialogWidth", "DialogHeight")


def ini_key(path):
    """Contents of an ini regardless of group and line order: merging parts changes it."""
    text = path.read_text(errors="replace")
    return sorted((n, tuple(sorted(l for l in ls if l.strip() and key_of(l) not in VOLATILE)))
                  for n, ls in parse_ini(text) if n or any(l.strip() for l in ls))


def is_dirty(name):
    """Whether the desktop differs from the saved theme name."""
    d = theme_dir(name)
    if not d.exists():
        return False
    probe = ROOT / ".probe"
    snapshot(probe, with_assets=False)
    try:
        a, b = d / "config", probe / "config"
        files = {p.relative_to(a) for p in a.rglob("*") if p.is_file()} | \
                {p.relative_to(b) for p in b.rglob("*") if p.is_file()}
        for rel in files:
            x, y = a / rel, b / rel
            if not (x.is_file() and y.is_file()) or ini_key(x) != ini_key(y):
                return True
        return False
    finally:
        shutil.rmtree(probe, ignore_errors=True)


# ── Previews and the list for the switcher ─────────────────────────────────────

def make_preview(name, force=False):
    """preview.jpg 480×270 from the theme's wallpaper (a frame if it is a video)."""
    d = theme_dir(name)
    out = d / "preview.jpg"
    if out.is_file() and not force:
        return out
    t = d / "config/plasma-org.kde.plasma.desktop-appletsrc"
    if not t.is_file():
        return None
    text = t.read_text(errors="replace")
    main_screen = setting("PreviewScreen", "0")
    cands = []
    for block in re.split(r"(?m)^(?=\[Containments\]\[\d+\]\n)", text):
        m = re.match(r"\[Containments\]\[(\d+)\]\n", block)
        if not m or "formfactor=0" not in block:
            continue
        cid = m.group(1)
        screen = re.search(r"(?m)^lastScreen=(\d+)", block)
        prio = 0 if screen and screen.group(1) == main_screen else 1
        wp = re.findall(rf"(?ms)^\[Containments\]\[{cid}\]\[Wallpaper\]\[[^\]]+\]\[General\]\n(.*?)(?=^\[|\Z)", text)
        for body in wp:
            for raw in re.findall(r"(?:file://)?(/[^\n\"',;]+)", body):
                path = Path(unquote(raw))
                if path.is_dir():              # wallpaper package: the largest image inside
                    imgs = sorted((path / "contents/images").glob("*"), key=lambda f: f.stat().st_size)
                    path = imgs[-1] if imgs else path
                if path.is_file() and re.search(MEDIA + "$", path.name, re.I):
                    cands.append((prio, path))
    if not cands:
        # A wallpaper without an image (a web page, a plain color): use the lock screen image.
        lock = d / "config/kscreenlockerrc.part"
        if lock.is_file():
            for raw in re.findall(r"(?:file://)?(/[^\n\"',;]+)", lock.read_text(errors="replace")):
                path = Path(unquote(raw))
                if path.is_file() and re.search(MEDIA + "$", path.name, re.I):
                    cands.append((2, path))
    if not cands:
        return None
    src = sorted(cands, key=lambda c: c[0])[0][1]
    vf = "scale=480:270:force_original_aspect_ratio=increase,crop=480:270"
    r = run("ffmpeg", "-v", "error", "-y", "-ss", "3", "-i", str(src), "-frames:v", "1",
            "-vf", vf, "-q:v", "3", str(out))
    if r.returncode != 0 or not out.is_file():   # shorter than 3 s or a still image
        run("ffmpeg", "-v", "error", "-y", "-i", str(src), "-frames:v", "1", "-vf", vf, "-q:v", "3", str(out))
    return out if out.is_file() else None


def cmd_json():
    import json
    cur = current()
    out = []
    for n in themes():
        d = ROOT / n
        prev = make_preview(n)
        out.append({"name": n, "current": n == cur,
                    "dirty": n == cur and is_dirty(n),
                    "icon": str(d / "icon.svg") if (d / "icon.svg").is_file() else "",
                    "preview": str(prev) if prev else ""})
    print(json.dumps({"current": cur, "lang": LANG, "themes": out}, ensure_ascii=False))


# ── Commands ───────────────────────────────────────────────────────────────────

def die(msg):
    print(msg, file=sys.stderr)
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        LOG.write_text(msg + "\n")
    except OSError:
        pass
    sys.exit(1)


def cmd_list():
    cur = current()
    names = themes()
    if not names:
        print(tr("No themes yet. Save the current desktop: desk save NAME"))
    for n in names:
        print(("* " if n == cur else "  ") + n)


def cmd_save(name):
    d = theme_dir(name)
    ROOT.mkdir(parents=True, exist_ok=True)
    snapshot(d)
    CURRENT.write_text(name)
    gc_assets()
    print(tr("Theme “{}” saved: {}", name, d))


def cmd_apply(name):
    d = theme_dir(name)
    if not d.exists():
        die(tr("No theme “{}”. Available: {}", name, ", ".join(themes()) or tr("nothing")))
    for m in missing_deps(d):
        print(tr("⚠ not installed: {}", m), file=sys.stderr)
    b = backup()
    install(d)
    CURRENT.write_text(name)
    print(tr("Theme “{}” applied. Previous state: {}", name, b))


def cmd_rm(name):
    d = theme_dir(name)
    if not d.exists():
        die(tr("No theme “{}”", name))
    shutil.rmtree(d)
    if name == current():
        CURRENT.write_text("")
    gc_assets()
    print(tr("Theme “{}” deleted", name))


def cmd_mv(old, new):
    a, b = theme_dir(old), theme_dir(new)
    if not a.exists():
        die(tr("No theme “{}”", old))
    if b.exists():
        die(tr("Theme “{}” already exists", new))
    a.rename(b)
    if current() == old:
        CURRENT.write_text(new)
    print(f"“{old}” → “{new}”")


def cmd_clean():
    b = backup()
    laf = read_key("kdeglobals", "KDE", "LookAndFeelPackage") or "org.kde.breezedark.desktop"
    r = run("plasma-apply-lookandfeel", "--apply", laf, "--resetLayout")
    if r.returncode != 0:
        die(r.stderr.strip() or tr("plasma-apply-lookandfeel failed"))
    CURRENT.write_text("")
    print(tr("Layout reset to stock ({}). Previous state: {}\nBuild a new desktop and save it: desk save NAME", laf, b))


def cmd_restore():
    olds = sorted(p for p in BACKUPS.iterdir() if p.is_dir()) if BACKUPS.exists() else []
    if not olds:
        die(tr("No backups"))
    last = olds[-1]
    install(last)
    try:
        CURRENT.write_text((last / "from").read_text())
    except OSError:
        pass
    shutil.rmtree(last)
    print(tr("Restored the state from {}", last.name))


# ── Window ─────────────────────────────────────────────────────────────────────

def kd(*args):
    r = subprocess.run(["kdialog", "--title", tr("Desktop Themes"), *args],
                       capture_output=True, text=True)
    return r.returncode, r.stdout.strip()


def gui():
    cur = current()
    items = []
    for n in themes():
        items += [f"apply:{n}", ("● " if n == cur else "    ") + n]
    items += ["save", "💾 " + tr("Save the current desktop as a new theme…")]
    if cur:
        items += ["update", "💾 " + tr("Overwrite theme “{}” with the current state", cur)]
    items += ["clean", "✨ " + tr("Start a new theme from a clean desktop"),
              "restore", "↩ " + tr("Go back to the state before the last switch")]
    if themes():
        items += ["mv", "✏ " + tr("Rename a theme…"), "rm", "🗑 " + tr("Delete a theme…")]
    head = tr("Now: “{}”", cur) if cur else tr("The current desktop is not saved as a theme")
    rc, choice = kd("--menu", head, *items)
    if rc != 0:
        return
    try:
        if choice.startswith("apply:"):
            name = choice[6:]
            if name == cur:
                if not is_dirty(cur):
                    kd("--msgbox", tr("Theme “{}” is already applied, no changes.", cur))
                    return
                rc, _ = kd("--warningyesno", tr("The desktop has changed since “{}” was applied.\n"
                                                "Reset it to the saved theme?\n"
                                                "(The current state goes to a backup.)", cur))
                if rc == 0:
                    cmd_apply(name)
                return
            if cur and is_dirty(cur):
                rc, _ = kd("--yesnocancel", tr("The desktop has changed since “{}” was applied.\n"
                                               "Save the changes to “{}” before switching?", cur, cur))
                if rc == 2:
                    return
                if rc == 0:
                    cmd_save(cur)
            cmd_apply(name)
            kd("--passivepopup", tr("Theme “{}” applied", name), "3")
        elif choice in ("save", "update"):
            name = cur if choice == "update" else ""
            if not name:
                rc, name = kd("--inputbox", tr("New theme name:"))
                if rc != 0 or not name.strip():
                    return
                name = name.strip()
                if name in themes():
                    rc, _ = kd("--warningyesno", tr("Theme “{}” already exists. Overwrite?", name))
                    if rc != 0:
                        return
            cmd_save(name)
            kd("--passivepopup", tr("Theme “{}” saved: {}", name, theme_dir(name)), "3")
        elif choice == "clean":
            rc, _ = kd("--warningyesno", tr("Panels and widgets will be reset to the defaults.\n"
                                            "The current state goes to a backup. Continue?"))
            if rc == 0:
                if cur and is_dirty(cur):
                    rc, _ = kd("--yesno", tr("Save the changes to “{}”?", cur))
                    if rc == 0:
                        cmd_save(cur)
                cmd_clean()
        elif choice == "restore":
            cmd_restore()
        elif choice == "mv":
            rc, old = kd("--combobox", tr("Which theme to rename?"), *themes())
            if rc == 0 and old:
                rc, new = kd("--inputbox", tr("New name:"), old)
                if rc == 0 and new.strip() and new.strip() != old:
                    cmd_mv(old, new.strip())
        elif choice == "rm":
            rc, name = kd("--combobox", tr("Which theme to delete?"), *themes())
            if rc == 0 and name:
                rc, _ = kd("--warningyesno", tr("Delete theme “{}” for good?", name))
                if rc == 0:
                    cmd_rm(name)
    except SystemExit as e:
        if e.code:
            kd("--error", tr("Something went wrong. Details: {}", LOG))
        raise
    except Exception:
        import traceback
        LOG.parent.mkdir(parents=True, exist_ok=True)
        LOG.write_text(traceback.format_exc())
        kd("--error", tr("Error in desk:\n\n{}\n\nFull log: {}", traceback.format_exc(limit=3)[-1500:], LOG))
        raise


def main(argv):
    if not argv or argv[0] == "gui":
        return gui()
    cmd, args = argv[0], argv[1:]
    one = lambda: args[0] if args else die(tr("Usage: desk {} NAME", cmd))
    if cmd in ("list", "ls"):
        cmd_list()
    elif cmd == "save":
        cmd_save(one())
    elif cmd == "apply":
        cmd_apply(one())
    elif cmd in ("rm", "delete"):
        cmd_rm(one())
    elif cmd == "json":
        cmd_json()
    elif cmd == "preview":
        for n in (args or themes()):
            print(n, make_preview(n, force=True))
    elif cmd == "mv":
        len(args) == 2 or die(tr("Usage: desk mv OLD NEW"))
        cmd_mv(*args)
    elif cmd == "clean":
        cmd_clean()
    elif cmd == "restore":
        cmd_restore()
    else:
        print(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
