#!/usr/bin/python3 -I
"""desk — save and switch whole KDE Plasma 6 workspaces: panels, widgets, wallpapers,
colors, icons, fonts, window decorations, lock screen.

A theme is a snapshot of "look" settings only. Shortcuts, mouse, monitors, tiling and
application settings are not part of a theme and never change on a switch.

    desk                  picker window (kdialog)
    desk list             list themes
    desk save NAME        save the current desktop as a theme (or overwrite it)
    desk apply NAME       switch to a theme
    desk rm NAME          delete a theme
    desk mv OLD NEW       rename a theme
    desk clean            reset to the stock Plasma layout to build a new theme
    desk restore          go back to the state before the last switch
    desk json             themes as JSON (used by the panel switcher)
    desk preview [NAME…]  regenerate preview images

Themes live in ~/.local/share/desk-themes/<name>/config/ — whole files and parts of files
from ~/.config. Wallpapers they reference are copied into the shared
~/.local/share/desk-themes/.assets/ (identical files are stored once) and the theme
points there, so a theme keeps working when the original file is moved or deleted.

Settings (optional), ~/.config/deskrc:
    [General]
    Language=ru          interface language: en or ru (default: from the locale)
    PreviewScreen=0      Plasma screen whose wallpaper becomes the theme preview
"""

import glob
import hashlib
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import quote, unquote

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
SHARE = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
ROOT = SHARE / "desk-themes"
BACKUPS = ROOT / ".backups"
CURRENT = ROOT / ".current"
ASSETS = ROOT / ".assets"
LOG = ROOT / ".last-error.log"
KEEP_BACKUPS = 5

# Files a theme takes whole. If a theme has no copy of a file, the live one is left alone
# (unless the theme lists it in .absent, see below).
WHOLE = [
    "plasma-org.kde.plasma.desktop-appletsrc",   # desktops, panels, widgets, wallpapers
    "plasmashellrc",                             # panel sizes and behaviour
    "plasmarc",                                  # Plasma style
    "ksplashrc",                                 # splash screen
    "breezerc", "auroraerc", "klassy/klassyrc", "lightlyrc", "darklyrc",  # window decorations
    "Kvantum/kvantum.kvconfig",                  # selected Kvantum theme (the themes themselves are not touched)
]

# Directories a theme takes whole and replaces completely on apply.
# kdedefaults is the "defaults" layer a global theme writes (Plasma style, decoration,
# splash, cursor, colors); Plasma puts it into XDG_CONFIG_DIRS before /etc/xdg. Without it
# the global theme of one desk theme shows through another.
WHOLE_DIRS = ["kdedefaults"]

# Directories under ~/.local/share a theme carries along (symlinks kept as is). A user copy
# of the desktop shell: kscreenlocker takes the lock screen from the shell package, so a
# custom lock screen is a copy of the shell with its lockscreen folder replaced. A theme
# without it removes such a copy on apply.
DATA_DIRS = ["plasma/shells/org.kde.plasma.desktop"]
ABSENT_DATA = ".absent-data"

# WHOLE files that did not exist when the theme was saved: they are deleted on apply so a
# file created by another theme does not override this one.
ABSENT = ".absent"

# Theme decoration files in the theme directory (for the switcher); snapshots keep them.
KEEP_FILES = ["icon.svg", "preview.jpg"]

# Files a theme takes only partly: whole groups (exact name or prefix) and single keys in a
# group. Everything else in these files is left alone on a switch.
PARTIAL = {
    "kdeglobals": [
        ("prefix", "Colors:"), ("prefix", "ColorEffects:"), ("group", "WM"), ("group", "Icons"),
        ("keys", "General", ["ColorScheme", "ColorSchemeHash", "AccentColor",
                             "LastUsedCustomAccentColor", "accentColorFromWallpaper",
                             "font", "fixed", "menuFont", "smallestReadableFont",
                             "toolBarFont", "taskbarFont", "activeFont",
                             "XftAntialias", "XftHintStyle", "XftSubPixel"]),
        ("keys", "KDE", ["LookAndFeelPackage", "widgetStyle", "contrast", "frameContrast",
                         "ShowIconsInMenuItems", "ShowIconsOnPushButtons"]),
    ],
    "kwinrc": [
        ("group", "org.kde.kdecoration2"), ("group", "Plugins"), ("prefix", "Effect-"),
        ("group", "TabBox"), ("group", "TabBoxAlternative"),     # Alt+Tab switcher look
    ],
    "kscreenlockerrc": [("prefix", "Greeter")],
    "kcminputrc": [("keys", "Mouse", ["cursorTheme", "cursorSize"])],
    "kxkbrc": [("keys", "Layout", ["DisplayNames"])],           # keyboard layout labels in the tray
    "mimeapps.list": [("keys", "Default Applications", ["inode/directory"])],  # file manager
    "krunnerrc": [("keys", "General", ["FreeFloating"])],      # KRunner at the top or centered
}

MEDIA = r"(?:jpe?g|png|webp|gif|svg|bmp|avif|jxl|mp4|webm|mkv|mov|avi|m4v)"
PATH_RE = re.compile(r"(?:file://)?(/[^\n\"',;]+?\." + MEDIA + r")(?=$|[\n\"',;])", re.I)


# ── Settings and language ──────────────────────────────────────────────────────

def setting(key, default=""):
    """A key from [General] of ~/.config/deskrc."""
    try:
        text = (CONFIG / "deskrc").read_text(errors="replace")
    except OSError:
        return default
    for name, lines in parse_ini(text):
        if name == "General":
            for line in lines:
                if key_of(line) == key:
                    return line.split("=", 1)[1].strip()
    return default


def language():
    lang = setting("Language")
    if not lang:
        for var in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
            if os.environ.get(var):
                lang = os.environ[var]
                break
    return "ru" if lang.lower().startswith("ru") else "en"


